# LeadRadar Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Which brain to use: ollama (local, free, private) | groq (hosted, free tier)
AI_PROVIDER=groq

# Local model — runs on your machine, nothing leaves it
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Hosted model — Groq free tier
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Search
SERPAPI_KEY=

# Database
MONGODB_URI=mongodb://localhost:27017/leadradar

# Temporal
# LOCAL:  uses the dev server started by `temporal server start-dev`
# CLOUD:  set the endpoint (namespace.account.tmprl.cloud:7233) plus TEMPORAL_API_KEY
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# Rate Limiting
MAX_LEADS_PER_SCAN=50
CLASSIFICATION_BATCH_SIZE=10
